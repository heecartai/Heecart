# Copy to .env for local development. In Cloudflare, add the same values as *build* variables
# (Settings -> Build -> Variables). Nothing here is secret: Vite puts these in the public site.

# The hidden CRM link: https://your-site/venkatesh
VITE_CRM_PATH=venkatesh

# The branch the CRM saves to (the same one Cloudflare deploys from).
VITE_GITHUB_BRANCH=main
